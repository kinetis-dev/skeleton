{
    "name": "kinetis/skeleton",
    "description": "The smallest possible runnable Kinetis application: nginx + PHP-FPM, one controller, one route, a welcome page.",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Alon Noy"
        }
    ],
    "require": {
        "php": "^8.4",
        "kinetis/framework": "^1.15.0",
        "psr/http-message": "^2.0"
    },
    "require-dev": {
        "infection/infection": "^0.35.0",
        "kinetis/mcp-docs": "^1.5.1",
        "kinetis/mcp-protocol": "^1.0.0",
        "kinetis/orbitron": "^1.7.0",
        "phpstan/phpstan": "^2.2.8",
        "phpunit/phpunit": "^13.3.3",
        "vimeo/psalm": "^6.17"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
